+
+// ---- NG64: background music on/off -------------------------------------------------------------------------------
+// libsm64's own stop/fade calls only act on music started through SM64's level-music queue; these start a track on
+// the level sequence player and stop it again (queue entry removed, player faded out).
+#include "decomp/audio/external.h"
+
+SM64_LIB_FN void sm64_ng64_music_play(uint8_t seqId)
+{
+    play_music( SEQ_PLAYER_LEVEL, SEQUENCE_ARGS( 4, seqId ), 0 );
+}
+
+SM64_LIB_FN void sm64_ng64_music_stop(uint16_t fadeFrames)
+{
+    uint16_t cur = get_current_background_music();
+    if( cur != 0xFFFF ) stop_background_music( cur );
+    seq_player_fade_out( SEQ_PLAYER_LEVEL, fadeFrames );
+}
