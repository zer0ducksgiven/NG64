+
+// ---- NG64: background music on/off -------------------------------------------------------------------------------
+// libsm64's own stop/fade calls only act on music started through SM64's level-music queue; these start a track on
+// the level sequence player and stop it again (queue entry removed, player faded out).
+#include "decomp/audio/external.h"
+
+// SM64 keeps the level music in a 6-deep queue and play_music() silently refuses once it's full. Every song change
+// used to add an entry, so after six changes the player was stuck on one song until the music was muted. One song at
+// a time here: whatever was queued is dropped first.
+extern u8 sBackgroundMusicQueueSize;
+
+SM64_LIB_FN void sm64_ng64_music_play(uint8_t seqId)
+{
+    sBackgroundMusicQueueSize = 0;
+    play_music( SEQ_PLAYER_LEVEL, SEQUENCE_ARGS( 4, seqId ), 0 );
+}
+
+SM64_LIB_FN void sm64_ng64_music_stop(uint16_t fadeFrames)
+{
+    sBackgroundMusicQueueSize = 0;
+    seq_player_fade_out( SEQ_PLAYER_LEVEL, fadeFrames );
+}
+
+#include "decomp/audio/load.h"
+
+// what the level sequence player is doing, for logs and tests: sequence loaded (0xFF none) | enabled << 8 | queue size << 16
+SM64_LIB_FN uint32_t sm64_ng64_music_status(void)
+{
+    extern u8 sCurrentBackgroundMusicSeqId, sBackgroundMusicQueueSize;
+    return ( (uint32_t)sBackgroundMusicQueueSize << 16 ) | ( gSequencePlayers[SEQ_PLAYER_LEVEL].enabled ? 0x100u : 0u ) | sCurrentBackgroundMusicSeqId;
+}
