+
+// ---- NG64: SM64 objects Mario can grab (a bob-omb) -----------------------------------------------------------------
+// interact_grabbable's last part: when the helper finds Mario punching or diving into a grabbable object, it offers it
+// here; on his next tick it is his interactObj with INPUT_INTERACT_OBJ_GRABBABLE set, so his own punch / dive code
+// (mario_check_object_grab) decides whether he faces it and picks it up, holds and throws it, as in the game. The helper
+// moves the real object; this one only stands in for it (its position is what Mario turns to).
+int32_t g_ng64TickMario;
+static struct Object s_ng64_grab[NG64_MAX_HELD];
+static int s_ng64_grabOffered[NG64_MAX_HELD];
+
+void ng64_apply_grab_offer(struct MarioState *m)
+{
+    int32_t id = g_ng64TickMario;
+    if( id < 0 || id >= NG64_MAX_HELD || !s_ng64_grabOffered[id] ) return;
+    s_ng64_grabOffered[id] = 0;
+    m->interactObj = &s_ng64_grab[id];
+    m->input |= INPUT_INTERACT_OBJ_GRABBABLE;
+}
+
+SM64_LIB_FN void sm64_ng64_offer_grab(int32_t marioId, float x, float y, float z)
+{
+    if( marioId < 0 || marioId >= NG64_MAX_HELD ) return;
+    struct Object *o = &s_ng64_grab[marioId];
+    if( !( gMarioState && ng64_bind( marioId ) && ( gMarioState->usedObj == o || gMarioState->heldObj == o ))) memset( o, 0, sizeof( *o ));
+    o->oPosX = x; o->oPosY = y; o->oPosZ = z;
+    s_ng64_grabOffered[marioId] = 1;
+}
+
+// 0: not his, 1: he is picking it up (reaching), 2: he holds it
+SM64_LIB_FN int32_t sm64_ng64_grab_status(int32_t marioId)
+{
+    if( marioId < 0 || marioId >= NG64_MAX_HELD || !ng64_bind( marioId )) return 0;
+    struct Object *o = &s_ng64_grab[marioId];
+    if( gMarioState->heldObj == o ) return 2;
+    if( gMarioState->usedObj == o && ( gMarioState->action == ACT_PICKING_UP || gMarioState->action == ACT_DIVE_PICKING_UP )) return 1;
+    return 0;
+}
